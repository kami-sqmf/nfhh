# nfhh 的設定。複製成 .env 後照著填 —— .env 不進版控（含密鑰與個資）。
#
#   cp .env.example .env

# ── 網域 ────────────────────────────────────────────────
# 唯一必填。以下三個子網域由它衍生，都要指向這台機器：
#   dnf.<網域>  管理面板（走 Cloudflare Tunnel）
#   dns.<網域>  DoT（DNS over TLS），手機的「私人 DNS」填這個
#   share.<網域>  轉發信箱的網域（Cloudflare Email Routing）
NFHH_DOMAIN=example.com

# acme.sh 的萬用憑證目錄。目錄名字面上就含星號，是 acme.sh 的命名慣例，
# 不是 glob。留空則用 /etc/ssl/*.${NFHH_DOMAIN}_ecc。
#NFHH_CERT_DIR=/etc/ssl/*.example.com_ecc

# 上面的衍生規則不合用時，個別覆寫：
#NFHH_RP_ID=dnf.example.com
#NFHH_ORIGIN=https://dnf.example.com
#NFHH_DOT_HOST=dns.example.com
#NFHH_MAIL_FROM=share@example.com
#NFHH_MAIL_DOMAIN=share.example.com

# ── 收信驗證 ────────────────────────────────────────────
# 收信端在 Authentication-Results 署名的 authserv-id。只有它寫的驗證結果算數。
# Cloudflare Email Routing 固定是 mx.cloudflare.net，換收信服務才需要改。
NFHH_MAIL_AUTHSERV_ID=mx.cloudflare.net

# ── 稽核 ────────────────────────────────────────────────
# 稽核表的保留期與列數上限。公開端點的每次失敗都寫一列，沒有上限就是免費的磁碟。
NFHH_AUDIT_KEEP_DAYS=90
NFHH_AUDIT_MAX_ROWS=20000

# ── 密鑰 ────────────────────────────────────────────────
# Email Worker 推送信件用的共用密鑰。與 Worker 的 PANEL_SECRET 相同。
# 產生：openssl rand -hex 32       留空則 /api/mail/ingest 停用。
NFHH_MAIL_SECRET=

# Resend。註冊流程寄 Email 驗證碼與邀請函用，留空則兩者停用。
RESEND_API_KEY=
#NFHH_INVITE_TEMPLATE=ott-share-invitation

# Cloudflare。查轉發收件人的驗證狀態、登記時自動建位址用。
# token 需要帳戶層級的 Email Routing Addresses 讀 + 寫。留空則兩者停用。
CF_ACCOUNT_ID=
CF_API_TOKEN=
